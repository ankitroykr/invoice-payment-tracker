<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>990c699b-e531-428a-a47d-4d0cac3ae62b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13"/>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.13"/>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0"/>
    <PackageReference Include="Serilog.Expressions" Version="5.0.0" />
    <!--
      Overrides the vulnerable System.Security.Cryptography.Pkcs 9.0.11 pulled in transitively by
      Microsoft.Data.SqlClient 6.1.7 (via Microsoft.EntityFrameworkCore.SqlServer).
      Fixes CVE-2026-84008 (high) and CVE-2026-70162 (moderate).
      Remove once EF Core depends on a SqlClient release with a patched Pkcs
      (SqlClient 6.1.8 is planned): https://github.com/dotnet/SqlClient/issues/4843
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13"/>
  </ItemGroup>

</Project>
