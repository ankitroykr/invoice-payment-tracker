@baseUrl = https://localhost:7160

# The API endpoints need a bearer token. readToken has the InvoiceTracker.Read role and writeToken has
# InvoiceTracker.ReadWrite. Both come from http-client.private.env.json, which git ignores, under the
# "dev" environment.

### Liveness check
# 200 if the app is up. Runs no checks, so it skips the database.
GET {{baseUrl}}/health/live
Accept: application/json

### Readiness check
# Runs the checks tagged "ready" (the database). 200 if they pass, 503 if not.
GET {{baseUrl}}/health/ready
Accept: application/json

### Unknown route
# 404 ProblemDetails, written by UseStatusCodePages as no endpoint matches.
# Needs a token: the fallback policy covers unknown routes too, so without one the API returns 401.
GET {{baseUrl}}/does-not-exist
Authorization: Bearer {{readToken}}
Accept: application/json

### Create a customer
# 201 from CreatedAtAction with no body.
# Saves the Location header as customerLocation (Rider only).
# Also saves the customer's ID, the last part of the Location header, as customerId for the invoice requests (Rider only).
# In other editors, replace {{customerId}} with that ID.
# In other editors, replace {{customerLocation}} with {{baseUrl}}/api/customers/{id}, using the ID from the Location header.
POST {{baseUrl}}/api/customers
Authorization: Bearer {{writeToken}}
Accept: application/json
Content-Type: application/json

{
  "name": "Tester Test",
  "email": "tester@example.com"
}

> {%
    client.global.set("customerLocation", response.headers.valueOf("Location"));
    client.global.set("customerId", response.headers.valueOf("Location").split("/").pop());
%}

### Get the customer just created
# Run "Create a customer" first, as it sets customerLocation. 200 with the customer.
GET {{customerLocation}}
Authorization: Bearer {{readToken}}
Accept: application/json

### Get a customer without a token
# 401 with a WWW-Authenticate: Bearer header, as the request has no token.
GET {{baseUrl}}/api/customers/1
Accept: application/json

### Create a customer with the read role only
# 403, as the CanWrite policy needs the InvoiceTracker.ReadWrite role.
POST {{baseUrl}}/api/customers
Authorization: Bearer {{readToken}}
Accept: application/json
Content-Type: application/json

{
  "name": "Reader Test",
  "email": "reader@example.com"
}

### Create a customer with invalid data
# 400 ValidationProblemDetails from ApiController.Problem, with errors for Name and Email.
POST {{baseUrl}}/api/customers
Authorization: Bearer {{writeToken}}
Content-Type: application/json
Accept: application/json

{
  "name": "",
  "email": "invalid-email"
}

### Create an invoice
# 201 from CreatedAtAction with no body. Run "Create a customer" first, as it sets customerId.
# Expected total: 4 × 55 = 220.00, plus 1 × 0.125 rounded to 0.13, so 220.13.
POST {{baseUrl}}/api/invoices
Authorization: Bearer {{writeToken}}
Accept: application/json
Content-Type: application/json

{
  "customerId": {{customerId}},
  "currency": "GBP",
  "lines": [
    { "description": "Website redesign", "quantity": 4, "unitPrice": 55 },
    { "description": "Printing", "quantity": 1, "unitPrice": 0.125 }
  ]
}

> {%
    client.global.set("invoiceLocation", response.headers.valueOf("Location"));
%}

### Get the invoice just created
# Run "Create an invoice" first, as it sets invoiceLocation. 200 with the invoice, its lines and total.
GET {{invoiceLocation}}
Authorization: Bearer {{readToken}}
Accept: application/json

### Create an invoice with an unsupported currency
# 422 Problem Details: a business rule (Invoice.CurrencyNotSupported), as XYZ is a valid code format but not a supported currency.
POST {{baseUrl}}/api/invoices
Authorization: Bearer {{writeToken}}
Accept: application/json
Content-Type: application/json

{
  "customerId": {{customerId}},
  "currency": "XYZ",
  "lines": [
    { "description": "Website redesign", "quantity": 1, "unitPrice": 100 }
  ]
}

### Create an invoice with invalid data
# 400 ValidationProblemDetails, with errors for CustomerId, Currency and Lines.
POST {{baseUrl}}/api/invoices
Authorization: Bearer {{writeToken}}
Accept: application/json
Content-Type: application/json

{
  "customerId": 0,
  "currency": "",
  "lines": []
}
