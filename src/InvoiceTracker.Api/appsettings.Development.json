{
  "Serilog": {
    "WriteTo": {
      "File": {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:t4}] {Message:lj} ({TraceId}){NewLine}{Exception}",
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 31,
          "retainedFileTimeLimit": "14.00:00:00"
        }
      }
    }
  }
}
